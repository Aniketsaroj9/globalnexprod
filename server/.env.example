# Server Environment Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev
MONGODB_URI=mongodb://localhost:27017/globalnex
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/globalnex?retryWrites=true&w=majority

JWT_SECRET=replace_this_with_a_64_character_hex_or_256_bit_secret_string
JWT_EXPIRATION_MS=604800000
JWT_COOKIE_NAME=token

CLIENT_ORIGIN=http://localhost:5173

# Email (SMTP or AWS SES)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
